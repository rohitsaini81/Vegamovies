---
const { currentPath = '/', searchQuery = '' } = Astro.props;

const navItems = [
	{ href: '/', label: 'Home' },
	{ href: '/trending', label: 'Trending' },
	{ href: '/popular', label: 'Popular' },
	{ href: '/upcoming', label: 'Upcoming' },
];
---
<header class="header">
	<a href="/">
		<img src="/assets/img/logo.png" alt="Vegamovies" class="d-block header__logo" width="270" height="80" loading="eager" />
	</a>
	<nav class="nav">
		<ul>
			{navItems.map((item) => (
				<li class={currentPath === item.href ? 'active' : ''}>
					<a href={item.href}>{item.label}</a>
				</li>
			))}
		</ul>
		<form method="get" action="/search" class="search__form">
			<input
				name="q"
				type="text"
				value={searchQuery}
				class="nav__search"
				id="search"
				placeholder="Search..."
				autocomplete="off"
			/>
			<button class="nav__searchBtn" type="submit" aria-label="Search">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="currentColor">
					<path d="M10 2a8 8 0 105.293 14.293l4.707 4.707 1.414-1.414-4.707-4.707A8 8 0 0010 2zm0 2a6 6 0 110 12 6 6 0 010-12z" />
				</svg>
			</button>
		</form>
	</nav>
	<nav class="mob__nav">
		<div class="mob__nav__header">
			<span class="mob__nav__toggleBtn" data-menu-toggle>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28" fill="currentColor">
					<path d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z" />
				</svg>
			</span>
			<a href="/">
				<img src="/assets/img/logo.png" alt="Vegamovies" class="mob__header__logo" width="240" height="70" />
			</a>
			<span class="mob__nav__toggleBtn" data-search-toggle>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24" fill="currentColor">
					<path d="M10 2a8 8 0 105.293 14.293l4.707 4.707 1.414-1.414-4.707-4.707A8 8 0 0010 2zm0 2a6 6 0 110 12 6 6 0 010-12z" />
				</svg>
			</span>
		</div>
		<div class="mob__nav__bar" data-menu>
			<span class="mob__nav__toggleBtn" data-menu-toggle>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="26" height="26" fill="currentColor" class="mob__nav__bar__closeBtn">
					<path d="M18.3 5.71L12 12l6.3 6.29-1.41 1.42L10.59 13.4 4.29 19.71 2.88 18.3 9.17 12 2.88 5.71 4.29 4.29l6.3 6.3 6.3-6.3z" />
				</svg>
			</span>
			<ul>
				{navItems.map((item) => (
					<li class={currentPath === item.href ? 'active' : ''}>
						<a href={item.href}>{item.label}</a>
					</li>
				))}
			</ul>
		</div>
		<div class="mob__nav__searchBar" data-search>
			<form method="get" action="/search" class="mob__nav__search__form">
				<input
					name="q"
					type="text"
					value={searchQuery}
					class="mob__nav__search"
					id="mobSearch"
					placeholder="Search..."
					autocomplete="off"
				/>
				<button class="mob__nav__searchBtn" type="submit" aria-label="Search">
					<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="currentColor">
						<path d="M10 2a8 8 0 105.293 14.293l4.707 4.707 1.414-1.414-4.707-4.707A8 8 0 0010 2zm0 2a6 6 0 110 12 6 6 0 010-12z" />
					</svg>
				</button>
			</form>
		</div>
	</nav>
	<div class="platforms hideScrollBar" aria-hidden="true">
		<img src="/assets/img/platforms/Netflix.png" alt="Netflix" loading="lazy" />
		<img src="/assets/img/platforms/Prime_Video.jpg" alt="Prime Video" loading="lazy" />
		<img src="/assets/img/platforms/DSNP_Hotstar.png" alt="Disney+ Hotstar" loading="lazy" />
		<img src="/assets/img/platforms/Apple-TV-Logo.png" alt="Apple TV" loading="lazy" />
		<img src="/assets/img/platforms/Zee5.jpg" alt="Zee5" loading="lazy" />
		<img src="/assets/img/platforms/Sonyliv.png" alt="Sony Liv" loading="lazy" />
		<img src="/assets/img/platforms/ullu.jpg" alt="Ullu" loading="lazy" />
		<img src="/assets/img/platforms/Altbalaji.jpg" alt="Alt Balaji" loading="lazy" />
		<img src="/assets/img/platforms/Voot.jpg" alt="Voot" loading="lazy" />
	</div>
</header>

<script>
	const menu = document.querySelector('[data-menu]');
	const search = document.querySelector('[data-search]');

	document.querySelectorAll('[data-menu-toggle]').forEach((toggle) => {
		toggle.addEventListener('click', () => {
			menu?.classList.toggle('active');
		});
	});

	document.querySelectorAll('[data-search-toggle]').forEach((toggle) => {
		toggle.addEventListener('click', () => {
			search?.classList.toggle('active');
			const input = search?.querySelector('input');
			if (search?.classList.contains('active')) {
				input?.focus();
			} else {
				input?.blur();
			}
		});
	});

	menu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			menu?.classList.remove('active');
		});
	});
</script>
