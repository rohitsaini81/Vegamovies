---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import MovieCard from '../components/MovieCard.astro';
import Pagination from '../components/Pagination.astro';
import Footer from '../components/Footer.astro';
import { tmdb } from '../lib/tmdb.js';

const page = Number(Astro.url.searchParams.get('page') ?? '1');
const videos = await tmdb('/movie/popular', {
	page,
	include_adult: false,
});

const title = 'Popular Movies';
const description = 'Explore popular movies ranked by audience demand and ratings.';
---
<BaseLayout title={title} description={description}>
	<Header currentPath={Astro.url.pathname} />
	<main class="main">
		<h1 class="visually-hidden">Popular Movies</h1>
		<div class="movie">
			<div class="movie__wrapper">
				{videos.results?.map((video) => (
					<MovieCard video={video} />
				))}
			</div>
			<Pagination page={videos.page} totalPages={videos.total_pages} />
		</div>
	</main>
	<Footer />
</BaseLayout>
